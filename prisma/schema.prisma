generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Receipt {
  id                  String   @id @default(uuid())
  production_name     String
  date                DateTime @default(now())
  department          String
  crew_member_name    String
  crew_role           String
  scene_usid          String
  script_date         String?
  ai_tool_used        String
  tool_status         String
  whitelist_condition String?
  por_description     String
  sel_output          String?
  sel_description     String
  sel_detail          String?
  adj_description     String
  status              String   @default("PENDING_AUTH")
  crew_confirmed_at   DateTime?
  auth_signer         String?
  auth_timestamp      DateTime?
  lct_required        Boolean  @default(false)
  lct_reference       String?
  lct_child_performer Boolean  @default(false)
  lct_child_age_bracket        String?
  lct_guardian_name            String?
  lct_guardian_consent_ref     String?
  lct_performance_licence_ref  String?
  notes               String?
  twin_lock_hash      String?
  created_at          DateTime @default(now())
  vfx_software        String?
  vfx_data_location   String?
  vfx_no_training_confirmed Boolean @default(false)
  vfx_input_type      String?
  vfx_output_type     String?
  vfx_lct_confirmed   Boolean @default(false)
  sound_processing_location   String?
  sound_processing_type       String?
  sound_performer_audio       Boolean @default(false)
  sound_no_training_confirmed Boolean @default(false)
  writing_stage               String?
  writing_submitted_material  String?
  writing_processing_location String?
  writing_guild_status        String?
  writing_ai_contribution     String?
  writing_no_training_confirmed Boolean @default(false)
  writing_authorship_declared Boolean @default(false)
  writing_wga_writers_count   Int?
  writing_wga_registration    String?
  writing_wggb_context        String?
  writing_wggb_paternity      Boolean @default(false)
}

model WhitelistEntry {
  id          String   @id @default(uuid())
  toolName    String   @unique
  displayName String
  status      String
  condition   String?
  requiresLCT Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
